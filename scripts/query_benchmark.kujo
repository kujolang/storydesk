from src.storage_adapter import storage_initialize, storage_list_records
from src.common import get

mode := args()[0]; state := args()[1]; count := to_int(args()[2]); payload_bytes := to_int(args()[3]); adapter := args()[4]
if count < 1 || count > 20000 || payload_bytes < 1 || payload_bytes > 900000 { eprint("benchmark bounds exceeded"); exit(2) }
if mode == "seed" {
    result := storage_initialize(adapter,state,{"tool":"storydesk","contract_version":"1.0.0","storage_adapter":adapter}); if !result["ok"] { eprint("seed initialization failed"); exit(1) }
    mut db := null; if adapter == "sqlite" { db = db_connect("sqlite",state + "/storydesk.sqlite"); db_begin(db) }
    mut i := 0
    while i < count {
        id := "idea-benchmark-" + to_string(100000 + i)
        record := {"id":id,"record_type":"idea","created_at":"2026-09-22T12:00:00Z","payload":{"body":repeat("x",payload_bytes)}}
        text := to_json(record)
        if adapter == "sqlite" { db_execute(db,"INSERT INTO records(id,record_type,created_at,document,checksum) VALUES(?,?,?,?,?)",[id,"idea",record["created_at"],text,sha256(text)]) }
        else { write_file(state + "/records/" + id + ".json",text,true) }
        i = i + 1
    }
    if adapter == "sqlite" { db_commit(db); db_close(db) }
    print(to_json({"seeded":count,"adapter":adapter})); exit(0)
}
if mode != "scan" { eprint("mode must be seed or scan"); exit(2) }
mut cursor := ""; mut done := false; mut total := 0; mut body_bytes := 0; mut pages := 0; mut ids := []; mut maximum_page_bytes := 0
start := time()
while !done {
    page := storage_list_records(adapter,state,"idea",cursor,1000)
    if len(page["warnings"]) > 0 { eprint("benchmark source warning"); exit(1) }
    mut page_bytes := 0; mut next := cursor
    for record in page["records"] {
        body_bytes = body_bytes + len(record["payload"]["body"])
        page_bytes = page_bytes + len(to_json(record)); ids = push(ids,record["id"]); next = record["id"]; total = total + 1
    }
    if page_bytes > maximum_page_bytes { maximum_page_bytes = page_bytes }
    next = get(page,"next_after",next)
    if page["truncated"] && next == cursor { eprint("benchmark cursor stalled"); exit(1) }
    cursor = next; done = !page["truncated"]; pages = pages + 1
}
if total != count || body_bytes != count * payload_bytes { eprint("benchmark behavior mismatch"); exit(1) }
print(to_json({"adapter":adapter,"records":total,"body_bytes":body_bytes,"pages":pages,"elapsed_ms":time()-start,"max_page_document_bytes":maximum_page_bytes,"id_digest":sha256(join(ids,"\n"))}))
